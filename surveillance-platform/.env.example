# Database
DATABASE_URL=postgresql+asyncpg://surveillance:surveillance@localhost:5432/surveillance
DATABASE_URL_SYNC=postgresql://surveillance:surveillance@localhost:5432/surveillance

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# YOLO
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_DEVICE=cpu

# ByteTrack
TRACKER_MATCH_THRESHOLD=0.8
TRACKER_BUFFER=30

# Video
FRAME_BUFFER_SIZE=64
FRAME_SKIP_INTERVAL=2
MAX_CAMERAS=16

# Evidence Storage
EVIDENCE_STORAGE_PATH=./media/evidence
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_MAX_CLIP_SECONDS=30

# Camera Defaults
CAMERA_RECONNECT_DELAY_SECONDS=5
CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=10

# Performance
MAX_INFERENCE_WORKERS=4
DETECTION_BATCH_SIZE=1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Monitoring
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@surveillance.local
DEFAULT_ADMIN_PASSWORD=changeme
