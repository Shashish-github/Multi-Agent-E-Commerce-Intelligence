# Application Environment
ENV=development
PROJECT_NAME="Autonomous Multi-Agent E-Commerce Intelligence Platform"
VERSION=1.0.0

# Database URLs
# For zero-setup local SQLite (Default):
DATABASE_URL=sqlite+aiosqlite:///./ecommerce_intelligence.db
USE_SQLITE=true

# For PostgreSQL + pgvector (Docker Compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ecommerce_intelligence
# USE_SQLITE=false

# Security & Authentication
SECRET_KEY=your-cryptographically-secure-random-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional for external LLM API calls)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
